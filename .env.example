# ── Telegram ──────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here

# ── SeedDance 2.5 (ByteDance VolcEngine) ──────────────────────
# Получить: https://www.volcengine.com/  → Visual Intelligence
SEEDANCE_API_KEY=your_volcengine_access_key
SEEDANCE_SECRET_KEY=your_volcengine_secret_key

# ── Kling AI (Omni Flash) ──────────────────────────────────────
# Получить: https://platform.klingai.com/ → API Keys
KLING_ACCESS_KEY=your_kling_access_key
KLING_SECRET_KEY=your_kling_secret_key

# ── Luma Dream Machine (Flow) ──────────────────────────────────
# Получить: https://lumalabs.ai/dream-machine/api
LUMA_API_KEY=your_luma_api_key

# ── Runway ML Gen-4 ───────────────────────────────────────────
# Получить: https://runwayml.com/ → API Access
RUNWAY_API_KEY=your_runway_api_key

# ── Optional ───────────────────────────────────────────────────
# Comma-separated Telegram user IDs for admin access
ADMIN_IDS=123456789,987654321
